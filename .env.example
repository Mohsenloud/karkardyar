# APP_URL: The public URL where KarkardYar is hosted (e.g. https://karkard.example.com)
APP_URL=""

# APP_PORT: Host port exposed by Docker Compose on your VPS (default: 3080)
APP_PORT=3080

# BIND_HOST: Set to 127.0.0.1 if using Nginx/Caddy reverse proxy on the same VPS,
# or 0.0.0.0 to access directly via VPS IP (default: 0.0.0.0)
BIND_HOST=0.0.0.0

# TRUST_PROXY: Set to true when running behind Nginx, Caddy, or Cloudflare
TRUST_PROXY=false

# Optional initial admin credentials (if left blank, create admin via web UI on first visit):
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional Telegram Bot auto-backup delivery (kept strictly on server-side):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
